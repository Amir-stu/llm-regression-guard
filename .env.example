# Provider. `mock` runs fully offline and is the default; `openai` calls the real API.
RG_PROVIDER=mock
RG_MODEL=gpt-4o-mini
RG_JUDGE_MODEL=gpt-4o-mini

# Required only when RG_PROVIDER=openai
OPENAI_API_KEY=

# Alerting. Unset means alerts are skipped with a log line, not an error.
SLACK_WEBHOOK_URL=

# Where the published HTML report lives, used to build the Slack button link.
RG_REPORT_BASE_URL=

# Thresholds, as absolute fractions of pass rate.
RG_WARN_DELTA=0.03
RG_CRITICAL_DELTA=0.08
RG_SIGNIFICANCE_ALPHA=0.05

# Slow-drift detection.
RG_DRIFT_WINDOW=7
RG_DRIFT_FLOOR=0.85

# Runner
RG_CONCURRENCY=8
